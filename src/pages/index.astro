---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-16">

      <section id="presentacion" class="animate space-y-6 text-center">
        <img
          src="/avatar.jpg"
          alt="Foto de perfil"
          class="w-28 h-28 rounded-full object-cover mx-auto border border-black/10 dark:border-white/20"
        />
        <div class="space-y-3 max-w-md mx-auto">
          <h4 class="font-semibold text-black dark:text-white">
            Hola, soy [TU NOMBRE]
          </h4>
          <p>
            [2-3 líneas sobre ti: un hobby, interés o algo que te represente.]
          </p>
          <p>
            Este semestre quiero demostrar que [completa la frase].
          </p>
        </div>

        <div class="aspect-video w-full max-w-xl mx-auto rounded-lg overflow-hidden border border-black/10 dark:border-white/20">
          <iframe
            class="w-full h-full"
            src="https://www.youtube.com/embed/v7HyyOnixJ8"
            title="Video de presentación"
            allowfullscreen
          ></iframe>
        </div>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Evidencias
          </h5>
          <Link href="/projects">
            Ver todas
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Contacto
        </h5>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>

    </div>
  </Container>
</PageLayout>