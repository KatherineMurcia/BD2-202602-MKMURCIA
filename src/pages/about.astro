---
import PageLayout from "@layouts/PageLayout.astro";
import { ABOUT } from "@consts";

const interests = [
  { label: "Gym", icon: "M6.5 6.5 17.5 17.5 M4 9V4h5 M20 15v5h-5 M6.5 17.5 4 20 M17.5 6.5 20 4" },
  { label: "Ciclismo de montaña", icon: "M5 17.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM19 17.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM12 17.5 15 7l-5 0-4.5 6.5M15 7l3 5" },
  { label: "Running", icon: "M13 4a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM8 21l2-5 2-2-1-4 4 1 3 4M6 12l3-3 3 1" },
  { label: "Naturaleza", icon: "M12 2C8 6 6 9 6 12a6 6 0 0 0 12 0c0-3-2-6-6-10ZM12 22v-8" },
  { label: "Animales", icon: "M4.5 9.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM9.5 6.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM14.5 6.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM19.5 9.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM12 21c-3.5 0-6-2-6-4.5 0-2 1.5-3 2.5-4.5S10 9 12 9s2.5 1.5 3.5 3 2.5 2.5 2.5 4.5c0 2.5-2.5 4.5-6 4.5Z" },
];
---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>

  <!-- Encabezado -->
  <div class="w-full bg-slate-100 dark:bg-slate-900/60 border-b border-slate-900/10 dark:border-slate-100/10">
    <div class="mx-auto max-w-screen-md px-5 py-16 flex flex-col items-center text-center gap-5 animate">
      <img
        src="/avatar.jpg"
        alt="Foto de perfil"
        class="w-32 h-32 rounded-full object-cover object-top border-4 border-white dark:border-slate-900 shadow-sm"
      />
      <div>
        <p class="text-xs uppercase tracking-widest text-slate-600 dark:text-slate-400 font-semibold mb-1">
          Sobre mí
        </p>
        <h1 class="font-semibold text-black dark:text-white text-2xl">
          Katherine Murcia
        </h1>
        <p class="text-sm mt-1">
          Ingeniería de Sistemas · 5to semestre
        </p>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-screen-md px-5 py-14 space-y-14">

    <!-- Intereses como tarjetas con ícono -->
    <section class="animate grid grid-cols-2 sm:grid-cols-5 gap-3">
      {interests.map(item => (
        <div class="flex flex-col items-center gap-2 text-center p-3 rounded-xl border border-black/10 dark:border-white/15">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-6 stroke-slate-600 dark:stroke-slate-300 fill-none stroke-2" stroke-linecap="round" stroke-linejoin="round">
            <path d={item.icon} />
          </svg>
          <span class="text-xs">{item.label}</span>
        </div>
      ))}
    </section>

    <!-- Contenido -->
    <div class="max-w-xl mx-auto space-y-10 text-left">

      <section class="animate space-y-3">
        <h2 class="font-semibold text-black dark:text-white uppercase text-sm tracking-wide">
          Quién soy
        </h2>
        <p>
          Soy llanera, nací en San Martín - Meta, vivo en Bogotá aproximadamente hace 9 años. Soy estudiante de quinto semestre de Ingeniería de Sistemas. Disfruto el deporte al aire libre y la naturaleza: practico gym, ciclismo de montaña y running, y me encantan los animales.
        </p>
      </section>

      <section class="animate space-y-3">
        <h2 class="font-semibold text-black dark:text-white uppercase text-sm tracking-wide">
          Este semestre en Bases de Datos 2
        </h2>
        <p>
          Curso esta materia con la meta de fortalecer estas habilidades y aplicarlas directamente en mi trabajo. Me propongo complementar lo visto en clase con estudio autónomo, aprovechando el acompañamiento del profesor para profundizar más allá del contenido del curso.
        </p>
      </section>

      <blockquote class="animate bg-slate-100 dark:bg-slate-900/60 border-l-4 border-slate-600 dark:border-slate-400 pl-5 py-4 pr-4 rounded-r-lg italic text-black/80 dark:text-white/80">
        "Soy llanera y me apasiona estudiar. Este semestre quiero demostrarle al profesor que puedo apropiarme de Bases de Datos por mi cuenta, ir más allá de lo visto en clase, y llevar ese conocimiento a un contexto profesional real."
      </blockquote>

      <section class="animate space-y-3">
        <h2 class="font-semibold text-black dark:text-white uppercase text-sm tracking-wide">
          Mi presentación
        </h2>
        <div class="aspect-video w-full rounded-lg overflow-hidden border border-black/10 dark:border-white/20">
          <iframe
            class="w-full h-full"
            src="https://www.youtube.com/embed/v7HyyOnixJ8"
            title="Video de presentación"
            allowfullscreen
          ></iframe>
        </div>
      </section>

    </div>
  </div>
</PageLayout>